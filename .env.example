# Supabase (database; no auth in this single-user tool)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: photos (images bucket) and generated clips/voiceover (videos bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_IMAGES_BUCKET=
R2_VIDEOS_BUCKET=

# Optional: if set, Gemini writes the script and post copy instead of Claude
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude: reads the label (and writes the script when no Gemini key)
ANTHROPIC_API_KEY=
# Optional: model override (default claude-sonnet-5-5)
ANTHROPIC_MODEL=

# ElevenLabs: voiceover. Use any voice id from your account (elevenlabs.io > Voices).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional (default eleven_multilingual_v2)
ELEVENLABS_MODEL=
# Refuse to voice scripts longer than this many characters (about 1 minute is ~900)
MAX_VOICE_CHARS=1800

# fal.ai: Wan 2.5 image-to-video
FAL_KEY=
# Default clip quality: 480p draft ($0.05/s) or 720p final ($0.10/s). 1080p is not offered.
WAN_RESOLUTION=480p
# Most animated clips allowed per scan (each is 5 seconds)
MAX_CLIPS=4

# Set to true to test the whole flow for free: silent voiceover, clips reuse your photos.
MOCK_AI=false

# Final video render (ffmpeg-static is used automatically; these are optional)
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FONTS_DIR=./assets/fonts
# RENDER_PRESET=veryfast

# Social posting (Social tab). APP_PASSWORD is required before connecting any account.
APP_PASSWORD=
# 16+ random characters; encrypts the saved Instagram / TikTok tokens
TOKEN_ENCRYPTION_KEY=
# Your deployed https URL, used for the OAuth redirect (e.g. https://your-app.vercel.app)
APP_URL=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram API with Instagram Login (Meta developer app)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
